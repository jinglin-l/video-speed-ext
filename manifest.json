{
  "manifest_version": 2,
  "name": "Private Video Speed",
  "version": "1.1.0",
  "description": "Minimal, offline clone of Video Speed Controller. No permissions, no storage, no network.",
  "browser_specific_settings": {
    "gecko": {
      "id": "private-video-speed@local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
